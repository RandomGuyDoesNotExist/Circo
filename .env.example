# Circo (CircleShare) Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# NOTE: .env is ignored in git and must NEVER be committed.

# Application Environment & Build Version
NODE_ENV=production
TAG=latest
HTTP_PORT=8080
ADMINER_PORT=8082

# PostgreSQL Database Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=circo
DB_USER=circo_user
DB_PASSWORD=circo_pass

# JWT Authentication Secret
JWT_SECRET=circle-super-secret-jwt-key-2026

# Inter-service URLs
REALTIME_URL=http://realtime-service:6000
